# Bu dosyayı ".env" olarak kopyalayın ve değerleri doldurun.
#   cp .env.example .env
# .env dosyası .gitignore içindedir, git'e gönderilmez.

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI API anahtarı. Boş bırakılırsa yerel NLP çalışır,
# AI ile anlamsal değerlendirme ve içerik özeti devre dışı kalır.
AI_API_KEY=

# OAuth token'larını şifrelemek için Base64 kodlu 32 byte'lık AES anahtarı.
# Üretmek için: openssl rand -base64 32
# Dev profilinde boş bırakılabilir (sabit geliştirme anahtarı kullanılır).
TOKEN_ENCRYPTION_KEY=
